# Porta da API
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Conexão com o PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guia_turistico?schema=public"

# Segurança e JWT
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars-long"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-change-in-production-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Segredo do hash de CPF/CNPJ dos comerciantes (opcional; sem ele usa o JWT_SECRET). Não mude depois de ter usuários.
DOCUMENT_PEPPER="troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"

# Rate Limit (Requisições por minuto)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# URL pública da API (usada nas URLs das fotos enviadas)
PUBLIC_URL="http://localhost:3333"

# CORS Permissões (Separadas por vírgula)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081"
